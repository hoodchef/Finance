// GENERATED FROM schema.prisma BY scripts/mirror-schema.mjs — DO NOT EDIT.
//
// SQLite mirror, for local tests only. Prisma cannot take its datasource
// provider from an environment variable, so verifying the repository without
// standing up Postgres needs a second schema. Native type hints and Json are
// translated because SQLite has neither; the MODELS must not drift, and
// tests/prisma.test.ts fails if they do.
//
//   npm run db:mirror && npm run db:push:test
// Postgres model for server-side portfolio storage.
//
// NOT WIRED IN. The running app keeps portfolios in browser local storage, so
// it needs no database. This schema is the target for the migration described
// in src/lib/storage.ts: implement PortfolioRepository against Prisma, point
// the store at it, and nothing else changes.
//
//   npx prisma migrate dev --name init
//
// Note what is *not* here: no price or dividend tables. Market data is cached
// on disk by the provider layer and is disposable — a warm cache is a
// performance detail, never a source of truth, and a stale row in a prices
// table is the easiest way to produce a wrong backtest that looks right.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/test-client"
}

datasource db {
  provider = "sqlite"
  url      = env("SQLITE_URL")
}

model User {
  id         String      @id @default(cuid())
  email      String      @unique
  name       String?
  /// Auth.js writes these; they are not used by the app directly.
  emailVerified DateTime?
  image      String?
  /// Argon2/bcrypt hash for credentials sign-in. Null for OAuth-only users.
  passwordHash String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  portfolios Portfolio[]
  runs       BacktestRun[]
  accounts   Account[]
  sessions   Session[]
}

/// Auth.js: one row per linked OAuth provider.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Auth.js: database-backed sessions.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Auth.js: email sign-in tokens.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Portfolio {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  /// Set when the portfolio was created from a built-in preset.
  presetId  String?
  positions Position[]
  runs      BacktestRun[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId, updatedAt])
}

model Position {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  symbol      String
  /// Display name captured at the time the holding was added.
  name        String?
  /// Target weight as a percentage, e.g. 40 for 40%.
  weight      Decimal
  /// Annual fund expense ratio in percent. Null means "do not model one".
  expenseRatio Decimal?
  /// Display order in the builder.
  sortOrder   Int       @default(0)

  @@index([portfolioId, sortOrder])
}

/// An executed backtest, kept so a result can be reopened by link.
/// Only the inputs and the headline outputs are stored; the full daily ledger
/// is recomputed on demand, because the engine is deterministic and storing
/// derived series would let them drift from the code that produced them.
model BacktestRun {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioId String?
  portfolio   Portfolio? @relation(fields: [portfolioId], references: [id], onDelete: SetNull)

  /// Serialised BacktestConfig, exactly as the engine received it.
  config        String
  /// Engine version, so an old run is never silently re-read under new maths.
  engineVersion String
  /// Provider id the prices came from, plus whether they were synthetic.
  dataSource    String
  synthetic     Boolean  @default(false)

  effectiveStart DateTime
  effectiveEnd   DateTime
  finalValue     Decimal
  totalReturn    Decimal
  cagr           Decimal
  volatility     Decimal
  maxDrawdown    Decimal
  sharpe         Decimal

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
