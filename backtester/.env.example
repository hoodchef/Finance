# Market data provider: "yahoo" (live, no key required) or "demo" (synthetic, clearly labelled)
MARKET_DATA_PROVIDER=yahoo

# Directory used to cache downloaded price history between runs.
MARKET_DATA_CACHE_DIR=.cache/market-data

# Optional. Only needed if you switch the saved-portfolio store from browser
# storage to Postgres (see prisma/schema.prisma and README "Persistence").
# DATABASE_URL=postgresql://user:pass@localhost:5432/backtester
