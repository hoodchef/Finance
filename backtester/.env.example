# ---------------------------------------------------------------------------
# Market data
# ---------------------------------------------------------------------------
# Which provider serves price history. Chosen on the SERVER only — a request
# can never select it, so synthetic data cannot be requested by a client.
#
#   (unset)  Use Tiingo if TIINGO_API_KEY is set, otherwise Yahoo Finance.
#   tiingo   Documented, key-authenticated. 1,000 requests/day free.
#   yahoo    No key needed. Undocumented endpoint; rate-limits aggressively.
#   alphavantage  Canadian listings only, WEEKLY bars. Needs ALPHA_VANTAGE_API_KEY.
#   demo     SYNTHETIC. Generated prices for offline exploration. Every result
#            carries a permanent banner. Never valid for a real decision.
#
# An unrecognised value falls back to REAL data, never synthetic.
MARKET_DATA_PROVIDER=

# Tiingo API key — https://www.tiingo.com/ (free tier available).
# Verify the data contract after setting it:  npm run verify:data
#
# LICENSING: Tiingo's free and $30/month tiers are personal use only. You may
# not display or share the data with another person or organization. Building a
# product on it needs a redistribution licence. See src/lib/market-data/licence.ts.
TIINGO_API_KEY=

# Alpha Vantage API key — https://www.alphavantage.co/support/#api-key (free).
# Needed ONLY for Canadian listings (XEQT.TO, RY.TO, ...), which Tiingo does not
# carry. Served at WEEKLY resolution: the daily adjusted endpoint is premium and
# plain daily is capped at 100 bars. Any backtest touching a weekly holding runs
# at weekly resolution and says so — intra-week drawdowns are invisible, so the
# maximum drawdown shown is a floor rather than the figure.
#
# Free tier is 25 requests/day and throttles bursts well before that.
#
# LICENSING: personal use only. Redistribution needs a commercial plan.
ALPHA_VANTAGE_API_KEY=

# Where downloaded price history is cached between runs.
MARKET_DATA_CACHE_DIR=.cache/market-data

# ---------------------------------------------------------------------------
# Persistence (optional)
# ---------------------------------------------------------------------------
# Only needed if you move saved portfolios from browser storage to Postgres.
# See prisma/schema.prisma and the README "Persistence" section.
# DATABASE_URL=postgresql://user:pass@localhost:5432/backtester

# ---- Server-side storage and accounts (all optional) ----------------------
# Everything below is off by default. With none of it set the app keeps
# portfolios in the browser, needs no account, and no data leaves the machine.
#
# Setting DATABASE_URL alone enables server-side storage under a single local
# owner. Accounts additionally require NEXTAUTH_SECRET; a database without a
# secret is NOT authentication and the app treats it as still switched off.
DATABASE_URL=
# openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=
# OAuth providers are registered only when both halves of a pair are present.
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=

# ---- Local model (optional) ----------------------------------------------
# Turns a description into a proposed portfolio. Requires a local Ollama
# daemon; the feature is invisible without one and nothing is ever sent off
# the machine. Input only: the model picks tickers and weights, and never
# produces or narrates a result.
OLLAMA_HOST=
OLLAMA_MODEL=
