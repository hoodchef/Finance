/*
 * PENDING — a specification, not a passing suite.
 * =============================================================================
 * These describe a Polygon provider surface that is designed but not built:
 * cursor paging, split/dividend parsing into corporate actions, a derived
 * adjusted close, asset classification, the MarketDataProvider class and the
 * search mapping.
 *
 * They are kept because they are the specification, written against live
 * behaviour recorded on 2026-08-31, and because deleting them would lose that
 * record. Restore by moving a describe block into tests/polygon.test.ts and
 * implementing what it asks for.
 *
 * The parts that ARE built — the key handling, ticker normalisation, silent
 * truncation detection, rate limiting and request coalescing — are live in
 * tests/polygon.test.ts and passing.
 */
import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
import path from 'node:path';
import os from 'node:os';
import fs from 'node:fs';
import {
  PolygonNotEntitledError,
  PolygonProvider,
  PolygonRateLimitError,
  __testing,
  clearPolygonCache,
  fetchAggregates,
  fetchDividends,
  fetchSplits,
  normalisePolygonTicker,
  polygonConfigured,
  searchTickers,
} from '../src/lib/market-data/polygon';
import { UnknownSymbolError } from '../src/lib/market-data/provider';
import { clearMemoryCache } from '../src/lib/market-data/cache';
import { PROVIDER_LICENCES } from '../src/lib/market-data/licence';
import { reconcileDividends } from '../src/lib/market-data/integrity';
import type { PriceSeries } from '../src/lib/types';

/**
 * The Polygon provider, exercised against a mocked transport.
 *
 * The live key is on the free Stocks Basic plan — about five requests a
 * minute — so a test suite that called the real API would spend the user's
 * whole quota and then fail on its own rate limit. Every behaviour that
 * matters is reachable through the transport, and the recorded payload shapes
 * below are copied verbatim from live responses captured on 2026-08-31.
 *
 * The one live check is at the bottom, behind VERIFY_POLYGON=1.
 */

const KEY = 'test-key-not-a-real-one';

interface Recorded {
  url: string;
  authorization: string | null;
}

let calls: Recorded[] = [];
let routes: Array<[RegExp, () => Response]> = [];

function json(body: unknown, status = 200, headers: Record<string, string> = {}): Response {
  return new Response(JSON.stringify(body), {
    status,
    headers: { 'Content-Type': 'application/json', ...headers },
  });
}

function route(pattern: RegExp, respond: () => Response): void {
  routes.push([pattern, respond]);
}

/** A daily aggregate row, stamped at midnight New York as Polygon does. */
function agg(date: string, close: number, volume = 1_000_000) {
  return {
    t: Date.parse(`${date}T04:00:00Z`),
    o: close,
    h: close + 1,
    l: close - 1,
    c: close,
    v: volume,
    vw: close,
    n: 1000,
  };
}

beforeEach(() => {
  calls = [];
  routes = [];
  clearPolygonCache();
  clearMemoryCache();
  process.env.POLYGON_API_KEY = KEY;
  // An empty cache directory, so the disk tier cannot answer for the network
  // and a passing test cannot be a leftover from a previous run.
  process.env.MARKET_DATA_CACHE_DIR = fs.mkdtempSync(path.join(os.tmpdir(), 'polygon-test-'));

  vi.stubGlobal('fetch', async (input: URL | string, init?: RequestInit) => {
    const url = String(input);
    const headers = new Headers(init?.headers ?? {});
    calls.push({ url, authorization: headers.get('authorization') });
    for (const [pattern, respond] of routes) {
      if (pattern.test(url)) return respond();
    }
    throw new Error(`No mock route for ${url}`);
  });
});

afterEach(() => {
  vi.unstubAllGlobals();
});

describe('paging', () => {
  it('follows a Polygon-issued cursor', async () => {
    let page = 0;
    route(/\/v2\/aggs\//, () => {
      page += 1;
      return page === 1
        ? json({
            status: 'OK',
            results: [agg('2026-08-10', 100)],
            next_url: 'https://api.polygon.io/v2/aggs/next?cursor=abc',
          })
        : json({ status: 'OK', results: [agg('2026-08-11', 101)] });
    });

    const result = await fetchAggregates('AAPL', 'day', '2026-08-01', '2026-08-31');
    expect(result.bars.map((b) => b.date)).toEqual(['2026-08-10', '2026-08-11']);
    expect(result.coverage.pagesExhausted).toBe(false);
  });

  it('refuses to send the key to a host the cursor names', async () => {
    // next_url is provider-controlled input. Following it blindly would attach
    // the Authorization header to wherever the response said to.
    route(/api\.polygon\.io\/v2\/aggs\//, () =>
      json({
        status: 'OK',
        results: [agg('2026-08-10', 100)],
        next_url: 'https://evil.example.com/v2/aggs/next',
      }),
    );

    await expect(fetchAggregates('AAPL', 'day', '2026-08-01', '2026-08-31')).rejects.toThrow(
      /Refusing to send credentials/,
    );
    expect(calls.every((c) => c.url.startsWith('https://api.polygon.io'))).toBe(true);
  });
});

describe('the derived adjusted close', () => {
  it('back-adjusts by the reinvestment factor and rebases to the last bar', () => {
    // Three flat closes at 100 with a $1 dividend on the middle bar.
    //   factor steps by 1 / (1 - 1/100) = 1/0.99 on the ex-date
    //   rebased so the final bar has adjClose === close
    //   → bar 0 becomes 100 * 0.99 = 99, bars 1 and 2 stay 100.
    const bars = [
      { date: '2026-01-05', open: 100, high: 100, low: 100, close: 100, adjClose: 0, volume: 1 },
      { date: '2026-01-06', open: 100, high: 100, low: 100, close: 100, adjClose: 0, volume: 1 },
      { date: '2026-01-07', open: 100, high: 100, low: 100, close: 100, adjClose: 0, volume: 1 },
    ];
    __testing.withAdjustedClose(bars, [{ date: '2026-01-06', amount: 1 }]);
    expect(bars[0].adjClose).toBeCloseTo(99, 10);
    expect(bars[1].adjClose).toBeCloseTo(100, 10);
    expect(bars[2].adjClose).toBeCloseTo(100, 10);
  });

  it('leaves the series untouched when nothing was paid', () => {
    const bars = [
      { date: '2026-01-05', open: 10, high: 10, low: 10, close: 10, adjClose: 0, volume: 1 },
      { date: '2026-01-06', open: 12, high: 12, low: 12, close: 12, adjClose: 0, volume: 1 },
    ];
    __testing.withAdjustedClose(bars, []);
    expect(bars.map((b) => b.adjClose)).toEqual([10, 12]);
  });

  it('rederives the reported dividend through the integrity check', () => {
    // The convention integrity.reconcileDividends inverts. It agrees here by
    // construction — both sides come from the same two inputs — which is
    // worth knowing: for Polygon this check confirms the derivation, and
    // cannot detect a price/dividend disagreement the way it can for a
    // provider that supplies its own adjusted close.
    const bars = [
      { date: '2026-01-05', open: 50, high: 50, low: 50, close: 50, adjClose: 0, volume: 1 },
      { date: '2026-01-06', open: 49.5, high: 49.5, low: 49.5, close: 49.5, adjClose: 0, volume: 1 },
      { date: '2026-01-07', open: 51, high: 51, low: 51, close: 51, adjClose: 0, volume: 1 },
    ];
    const dividends = [{ date: '2026-01-06', amount: 0.5 }];
    __testing.withAdjustedClose(bars, dividends);

    const series = {
      meta: { symbol: 'X', name: 'X', assetClass: 'equity' },
      bars,
      dividends,
      splits: [],
      adjustment: 'split-adjusted',
      source: 'polygon',
      synthetic: false,
      fetchedAt: new Date().toISOString(),
    } as unknown as PriceSeries;

    const reconciled = reconcileDividends(series);
    expect(reconciled).toHaveLength(1);
    expect(reconciled[0].impliedFromAdjClose).toBeCloseTo(0.5, 10);
    expect(reconciled[0].relativeError).toBeLessThan(1e-9);
  });
});

